{
  "name": "promus",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "icons": "node scripts/build-icons.ts",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "dev:server": "DATA_DIR=./data node --watch apps/server/src/main.ts",
    "dev:web": "npm start -w apps/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.5",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.0",
    "vitest": "^4.1.12"
  }
}
