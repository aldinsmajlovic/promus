[Unit]
Description=Promus database backup

[Service]
Type=oneshot
User=promus
Group=promus
WorkingDirectory=/opt/promus
EnvironmentFile=/etc/promus/promus.env
ExecStart=/usr/bin/node apps/server/src/cli.ts backup
StateDirectory=promus
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
