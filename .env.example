# TCP port the server listens on.
PORT=8080
# Address to bind. Keep 127.0.0.1 and put tailscale serve or a reverse proxy in front.
HOST=127.0.0.1
# Directory for the database and backups/. Matches StateDirectory=promus in the systemd unit.
DATA_DIR=/var/lib/promus
# Log level: debug, info, warn or error.
LOG_LEVEL=info
